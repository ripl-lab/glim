# Claude Code container for this project, following the RIPL agentic coding
# standard. Generated by ripl_utils/ai_agents/claude-docker-project.sh; edit
# and commit it. docker/run.sh rebuilds the image whenever this file changes.
ARG BASE_IMAGE=ubuntu:22.04
FROM ${BASE_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive

# Common dev tooling.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      bash-completion build-essential ca-certificates curl file git gnupg \
      htop iputils-ping jq less locales lsof nano openssh-client pkg-config \
      procps python-is-python3 python3 python3-dev python3-pip python3-venv \
      ripgrep rsync sudo tree tzdata unzip vim wget xz-utils zip \
 && locale-gen en_US.UTF-8 \
 && rm -rf /var/lib/apt/lists/*

# ROS images: colcon and rosdep.
RUN if [ -d "/opt/ros/${ROS_DISTRO:-none}" ]; then \
      apt-get update \
      && apt-get install -y --no-install-recommends \
           python3-colcon-common-extensions python3-rosdep \
      && rm -rf /var/lib/apt/lists/*; \
    fi

# A user that matches the host user, so files in mounted folders keep the
# right ownership. Passwordless sudo so Claude can install things. (Root in
# the container still can't write to read-only mounts.)
ARG USERNAME
ARG GROUPNAME
ARG USER_UID
ARG USER_GID
RUN set -eu; \
    existing=$(getent passwd "${USER_UID}" | cut -d: -f1); \
    if [ -n "${existing}" ]; then userdel -r "${existing}" 2>/dev/null || true; fi; \
    if id "${USERNAME}" >/dev/null 2>&1; then userdel -r "${USERNAME}" 2>/dev/null || true; fi; \
    if ! getent group "${USER_GID}" >/dev/null; then \
      groupadd -g "${USER_GID}" "${GROUPNAME}" 2>/dev/null \
        || groupadd -g "${USER_GID}" "hostgroup"; \
    fi; \
    useradd -m -l -u "${USER_UID}" -g "${USER_GID}" -s /bin/bash "${USERNAME}"; \
    echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/90-claude-docker; \
    chmod 0440 /etc/sudoers.d/90-claude-docker; \
    install -d -m 0755 -o "${USER_UID}" -g "${USER_GID}" "/home/${USERNAME}/.claude"; \
    touch "/home/${USERNAME}/.sudo_as_admin_successful"; \
    if [ -d "/opt/ros/${ROS_DISTRO:-none}" ]; then \
      printf '%s\n' \
        "source /opt/ros/${ROS_DISTRO}/setup.bash" \
        '[ -f "${PROJECT_WS:-}/install/setup.bash" ] && source "$PROJECT_WS/install/setup.bash"' \
        >> "/home/${USERNAME}/.bashrc"; \
    fi

# Claude Code from Anthropic's signed apt repository.
RUN set -eu; \
    install -d -m 0755 /etc/apt/keyrings; \
    curl -fsSL https://downloads.claude.ai/keys/claude-code.asc \
      -o /etc/apt/keyrings/claude-code.asc; \
    if ! gpg --show-keys --with-colons /etc/apt/keyrings/claude-code.asc 2>/dev/null \
         | grep -q '^fpr:.*:31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE:'; then \
      echo "Claude Code signing key fingerprint did not match; aborting." >&2; exit 1; \
    fi; \
    echo "deb [signed-by=/etc/apt/keyrings/claude-code.asc] https://downloads.claude.ai/claude-code/apt/stable stable main" \
      > /etc/apt/sources.list.d/claude-code.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends claude-code; \
    rm -rf /var/lib/apt/lists/* /root/.claude /root/.claude.json

# ---------------------------------------------------------------------------
# Project dependencies: add the apt packages, pip installs, rosdep keys etc.
# this project needs, e.g.
#   RUN apt-get update && apt-get install -y --no-install-recommends \
#         libeigen3-dev ros-humble-pinocchio && rm -rf /var/lib/apt/lists/*
# ---------------------------------------------------------------------------

ENV LANG=en_US.UTF-8 \
    DISABLE_AUTOUPDATER=1
USER ${USERNAME}
WORKDIR /home/${USERNAME}
CMD ["bash"]
